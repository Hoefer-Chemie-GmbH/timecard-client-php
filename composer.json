{
  "name": "timecard/client",
  "description": "PHP client for a timeCard REST facade, generated from its OpenAPI specification",
  "version": "0.2.1",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.8",
    "guzzlehttp/psr7": "^2.6",
    "google/auth": "^1.40"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "TimecardClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TimecardClient\\Tests\\": "tests/"
    }
  }
}
